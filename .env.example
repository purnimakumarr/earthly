NODE_ENV=development
PORT=3000

# MongoDB connection string (Atlas or local) and the database to use
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=earthly

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Optional, at least 32 characters. Encrypts two-factor seeds; uses JWT_SECRET
# when empty. Set it before anyone enables 2FA: changing it later (or rotating
# JWT_SECRET while it is empty) makes existing seeds unreadable.
SECRET_BOX_KEY=

# Folder for uploaded images. Optional; defaults to ./uploads in the project.
UPLOAD_DIR=

# Public URL of the site, used for links in emails. Optional in development.
CLIENT_URL=http://localhost:5173

# Any SMTP provider (Mailtrap for development, Brevo/SendGrid in production).
# Leave SMTP_HOST empty to skip sending; emails are then only logged.
EMAIL_FROM=Earthly <hello@earthly.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Razorpay test-mode keys. Leave empty to run without payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
